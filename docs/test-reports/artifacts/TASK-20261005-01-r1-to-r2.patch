+
+    def test_seventh_job_allowed_eighth_rejected_without_rewriting_history(self):
+        """第七job可开始并继续第二源；第八job拒绝，原失败计数不清零。"""
+        for index in range(6):
+            self.attempt(f"job-{index}", f"attempt-{index}", 0)
+        history = self.ledger.read_bytes()
+        self.attempt("job-6", "seventh", 0)
+        self.attempt("job-6", "seventh-second-source", 0)
+        self.assertTrue(self.ledger.read_bytes().startswith(history))
