+                rows.append(_row(fields[0], dict(zip(("open", "close", "high", "low"), fields[1:5])), f"$.data.klines[{index}]"))
+        else:
+            if raw["code"] != "200" or raw["msg"] != "Success" or not isinstance(raw["data"], list):
