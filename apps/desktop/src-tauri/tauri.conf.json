{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TheWolf",
  "version": "0.1.0",
  "identifier": "com.thewolf.local",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TheWolf · 本地研究工作台",
        "width": 960,
        "height": 720,
        "minWidth": 520,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
